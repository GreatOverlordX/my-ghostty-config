theme = synthwave

# titlebar
shell-integration-features = no-cursor,sudo,no-title
adjust-cell-height = 1%

mouse-hide-while-typing = true
font-size = 10
cursor-style = block

# terminal - window style - opacity and titlebar decoration
background-opacity = 0.94
window-decoration = true
window-theme = ghostty
# more customizations (optional)
window-padding-balance = true
window-save-state = always
window-colorspace = "display-p3"
    
# maximise window - uncomment to activate (remove #)
# maximize

# KEYBINDS
keybind = global:ctrl+shift+m=toggle_maximize
keybind = global:ctrl+shift+e=new_split:right
keybind = global:ctrl+shift+d=new_split:down
keybind = global:ctrl+shift+w=close_tab
keybind = global:ctrl+shift+q=close_window


# theme is by choice synthwave - for manual customisation purposes
palette = 0=#000000
palette = 1=#f6188f
palette = 2=#1ebb2b
palette = 3=#fdf834
palette = 4=#2186ec
palette = 5=#f85a21
palette = 6=#d70000
palette = 7=#ffffff
palette = 8=#000000
palette = 9=#f841a0
palette = 10=#25c141
palette = 11=#fdf454
palette = 12=#2f9ded
palette = 13=#f97137
palette = 14=#19cde6
palette = 15=#ffffff
background = #000000
foreground = #ffffff
cursor-color = #ffd75f
cursor-text = #000000
selection-background = #949494
selection-foreground = #000000
